{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kleidos-dev/cla/blob/main/registry/schema/entities.schema.json",
  "title": "Kleidos CLA: entities that signed the entity version, and the accounts they cover (registry/entities.json on main)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entities"],
  "properties": {
    "schema": { "const": 1 },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "version", "set_sha256", "signed_at", "covered"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "integer", "minimum": 1 },
          "set_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "signed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "covered": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["github_id", "from"],
              "properties": {
                "github_id": { "type": "integer", "minimum": 1 },
                "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "until": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
              }
            }
          }
        }
      }
    }
  }
}
