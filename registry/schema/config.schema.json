{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kleidos-dev/cla/blob/main/registry/schema/config.schema.json",
  "title": "Kleidos CLA: configuration read by the bot and the recorder (registry/config.json on main)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "agreement", "current_version", "accepted_versions", "versions", "served_repositories", "exempt"],
  "properties": {
    "schema": { "const": 1 },
    "agreement": { "const": "kleidos-ca" },
    "current_version": { "type": "integer", "minimum": 1 },
    "coverage_from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Pull requests merged before this date predate the register and need no coverage record" },
    "accepted_versions": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "uniqueItems": true },
    "versions": {
      "type": "object",
      "patternProperties": {
        "^[1-9][0-9]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "set_sha256", "files", "sentence"],
          "properties": {
            "path": { "type": "string", "pattern": "^agreements/v[1-9][0-9]*$" },
            "set_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "files": {
              "type": "object",
              "additionalProperties": false,
              "required": ["individual.md", "entity.md", "addendum.md"],
              "patternProperties": { "^[a-z]+\\.md$": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
            },
            "sentence": { "type": "string", "minLength": 1 }
          }
        }
      },
      "additionalProperties": false
    },
    "served_repositories": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["auto_approve"],
          "properties": { "auto_approve": { "type": "boolean" } }
        }
      },
      "additionalProperties": false
    },
    "exempt": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "login", "why"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "login": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    }
  }
}
