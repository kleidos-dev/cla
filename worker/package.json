{
  "name": "kleidos-cla-worker",
  "version": "1.0.0",
  "private": true,
  "description": "The Kleidos CLA bot and signing site (Cloudflare Worker behind cla.kleidos.dev)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:agreement": "node scripts/check-agreement.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../scripts/tsconfig.json",
    "test": "vitest run",
    "deploy": "node scripts/check-agreement.mjs && wrangler deploy --var BUILD_COMMIT:$(git rev-parse HEAD)",
    "test:scripts": "node --test ../scripts/test/"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261122.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true
  }
}
